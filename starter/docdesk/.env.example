# Copy this file to .env (cp .env.example .env) and fill in the values.
# .env is ignored by Git; this example file is safe to commit.
# No quotes and no spaces around "=".

# Block 1: hosted model
OPENAI_API_KEY=sk-your-key-here
# a small, cheap model name from https://platform.openai.com/docs/models
DOCDESK_MODEL=

# Later blocks add their settings here, for example:
# OLLAMA_BASE_URL=http://localhost:11434   (Block 6)
# DATABASE_URL=...                         (Block 10)
